# Payments: start with emulator; change to sandbox when sandbox app credentials are configured.
REWIND_PROVIDER=emulator
REWIND_DB=rewind.db
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
REWIND_API_TOKEN=
REWIND_PUBLIC_URL=http://127.0.0.1:8000

# Live AI is the default. Set a provider-compatible model and key; no implicit fixture fallback.
# openai uses Responses API; openai_compatible uses Chat Completions; ollama runs locally.
REWIND_AI=openai_compatible
REWIND_AI_BASE_URL=https://api.openai.com/v1
REWIND_AI_MODEL=
REWIND_AI_API_KEY=
REWIND_AI_TIMEOUT=90
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Four-process local demo, launched with python -m rewind.devstack.
REWIND_MERCHANT=http
REWIND_MERCHANT_URL=http://127.0.0.1:8011
REWIND_INBOX_URL=http://127.0.0.1:8012
REWIND_FAULT_PROXY_URL=http://127.0.0.1:8013
# Devstack generates an ephemeral shared token if blank. Use a strong shared secret for deployments.
REWIND_SERVICE_TOKEN=
REWIND_MERCHANT_DB=rewind-merchant.db
REWIND_INBOX_DB=rewind-inbox.db
REWIND_PROXY_DB=rewind-proxy.db
REWIND_CHAOS=true
